{
  "name": "star-empathy-server",
  "version": "1.0.0",
  "description": "星语穹庭 — 后端 API 服务",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "seed": "ts-node scripts/seed.ts",
    "seed:history-collections": "ts-node scripts/seed-history-collections.ts",
    "migrate:default-collections": "ts-node scripts/migrate-default-collections.ts",
    "default-collections": "ts-node scripts/default-collections.ts",
    "agent:kernels": "ts-node scripts/generateKernels.ts",
    "agent:analyze": "ts-node scripts/generateAllAnalyses.ts",
    "fix:catalog": "ts-node scripts/fix-invalid-catalog-star-ids.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.0",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
